{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "dante",
    "Audience": "dante",
    "LifetimeMinutes": 60
  },
  "Banks": {
    "CatalogUrl": "https://brasilapi.com.br/api/",
    "SyncOnStartup": true
  },
  "Database": {
    "ApplyMigrations": true
  }
}
